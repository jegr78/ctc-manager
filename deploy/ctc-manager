#!/usr/bin/env bash
set -euo pipefail
umask 077
DEPLOY_ROOT=$(cd "$(dirname "$0")" && pwd -P)
export DEPLOY_ROOT
export PYTHONDONTWRITEBYTECODE=1
# shellcheck source=lib/common.sh
source "$DEPLOY_ROOT/lib/common.sh"
[ "$#" -ge 3 ] && [ "$1" = '--directory' ] || fail 'usage: ctc-manager --directory PATH OPERATION [OPTIONS]'
installation=$2
operation=$3
shift 3
case "$operation" in
  doctor|status|up|stop|publish-site) [ "$#" -eq 0 ] || fail 'unexpected operation arguments' ;;
  backup|restore-check|restore|resume-integrations|update-check|update|maintenance|prune|backup-check) ;;
  *) fail 'unknown operation' ;;
esac
python3 "$DEPLOY_ROOT/lib/config.py" validate "$installation"
installation=$(cd "$installation" && pwd -P)
cd "$installation"
docker_host=$(config_value dockerHost)
verify_daemon
case "$operation" in
  doctor)
    printf '%s\n' 'CTC configuration valid; rootless daemon and memory limits available'
    python3 "$DEPLOY_ROOT/lib/maintenance.py" --directory "$installation" doctor
    ;;
  status) compose ps --format json ;;
  publish-site)
    acquire_lock
    trap release_lock EXIT
    python3 "$DEPLOY_ROOT/lib/publication.py" --directory "$installation" --deploy-root "$DEPLOY_ROOT"
    ;;
  up|stop)
    acquire_lock
    trap release_lock EXIT
    write_journal started
    if [ "$operation" = up ]; then
      check_port
      compose up -d --wait --wait-timeout 180
    else
      compose stop app
    fi
    write_journal completed
    ;;
  backup|restore-check|restore|resume-integrations|update-check|update|maintenance|prune|backup-check)
    if [[ "$operation" == maintenance || "$operation" == prune || "$operation" == backup-check ]]; then
      # shellcheck source=lib/maintenance.sh
      source "$DEPLOY_ROOT/lib/maintenance.sh"
      runner=run_maintenance
    elif [[ "$operation" == update* ]]; then
      # shellcheck source=lib/update.sh
      source "$DEPLOY_ROOT/lib/update.sh"
      runner=run_update
    else
      # shellcheck source=lib/recovery.sh
      source "$DEPLOY_ROOT/lib/recovery.sh"
      runner=run_recovery
    fi
    acquire_lock
    trap release_lock EXIT
    trap 'write_journal interrupted; trap - EXIT; exit 143' TERM
    trap 'write_journal interrupted; trap - EXIT; exit 130' INT
    write_journal started
    if "$runner" "$@"; then
      write_journal completed
    else
      result=$?
      if [ "$result" -ge 128 ]; then
        write_journal interrupted
        trap - EXIT
      else
        write_journal failed
      fi
      exit "$result"
    fi
    ;;
esac
