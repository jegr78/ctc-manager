#!/usr/bin/env bash
set -euo pipefail
umask 077
DEPLOY_ROOT=$(cd "$(dirname "$0")" && pwd -P)
export DEPLOY_ROOT
export PYTHONDONTWRITEBYTECODE=1
# shellcheck source=lib/common.sh
source "$DEPLOY_ROOT/lib/common.sh"
[ "$#" -ge 3 ] && [ "$1" = '--directory' ] || fail 'usage: ctc-manager --directory PATH OPERATION [OPTIONS]'
installation=$2
operation=$3
shift 3
case "$operation" in
  doctor|status|up|stop|publish-site) [ "$#" -eq 0 ] || fail 'unexpected operation arguments' ;;
  deploy|backup|maintenance|restore|resume-integrations) ;;
  *) fail 'unknown operation' ;;
esac
python3 "$DEPLOY_ROOT/lib/config.py" validate "$installation"
installation=$(cd "$installation" && pwd -P)
cd "$installation"
docker_host=$(config_value dockerHost)
verify_daemon
# phpMyAdmin holds the lock for up to a minute while it starts.
case "$operation" in
  doctor)
    printf '%s\n' 'CTC configuration valid; rootless daemon and memory limits available'
    python3 "$DEPLOY_ROOT/lib/maintenance.py" --directory "$installation" doctor
    ;;
  status) compose ps --format json ;;
  publish-site)
    acquire_lock "${CTC_SHORT_LOCK_WAIT_SECONDS:-90}"
    trap release_lock EXIT
    python3 "$DEPLOY_ROOT/lib/publication.py" --directory "$installation" --deploy-root "$DEPLOY_ROOT"
    ;;
  up|stop)
    acquire_lock "${CTC_SHORT_LOCK_WAIT_SECONDS:-90}"
    trap release_lock EXIT
    if [ "$operation" = up ]; then
      check_port
      compose up -d --wait --wait-timeout 180
    else
      compose stop app
    fi
    ;;
  resume-integrations)
    acquire_lock "${CTC_SHORT_LOCK_WAIT_SECONDS:-90}"
    trap release_lock EXIT
    python3 "$DEPLOY_ROOT/lib/recovery.py" --directory "$installation" --deploy-root "$DEPLOY_ROOT" "$operation" "$@"
    ;;
  deploy|backup|maintenance|restore)
    [ "$operation" = maintenance ] && operation=backup
    acquire_lock "${CTC_LOCK_WAIT_SECONDS:-960}"
    trap release_lock EXIT
    # The Python child handles interrupts and rolls back; the launcher keeps the lock until it exits.
    trap '' HUP
    trap ':' TERM INT
    python3 "$DEPLOY_ROOT/lib/rollout.py" --directory "$installation" --deploy-root "$DEPLOY_ROOT" "$operation" "$@"
    ;;
esac
