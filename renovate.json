{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor"
  ],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "assignees": [
    "jegr78"
  ],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "dependencies"
    ],
    "schedule": [],
    "dependencyDashboardApproval": false,
    "prCreation": "immediate",
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Offer major updates without a dashboard approval gate.",
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": true,
      "dependencyDashboardApproval": false,
      "automerge": false
    },
    {
      "matchPackageNames": [
        "/^org\\.springframework\\.boot:/"
      ],
      "groupName": "Spring Boot"
    },
    {
      "matchPackageNames": [
        "/^org\\.springframework\\.security:/"
      ],
      "groupName": "Spring Security"
    },
    {
      "matchPackageNames": [
        "/^com\\.google\\.apis:google-api-services-/",
        "/^com\\.google\\.api-client:/",
        "/^com\\.google\\.auth:/"
      ],
      "groupName": "Google API clients"
    },
    {
      "matchPackageNames": [
        "/^org\\.testcontainers:/"
      ],
      "groupName": "Testcontainers"
    },
    {
      "matchPackageNames": [
        "/^org\\.openrewrite\\.maven:/",
        "/^org\\.openrewrite\\.recipe:/"
      ],
      "groupName": "OpenRewrite"
    },
    {
      "matchPackageNames": [
        "/^com\\.github\\.spotbugs:/",
        "/^com\\.h3xstream\\.findsecbugs:/"
      ],
      "groupName": "SpotBugs + find-sec-bugs"
    },
    {
      "description": "Keep Java major-version declarations at major precision.",
      "matchDatasources": [
        "java-version"
      ],
      "matchCurrentValue": "/^\\d+$/",
      "versioning": "semver-partial"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^pom\\.xml$/"
      ],
      "matchStrings": [
        "<java\\.version>\\s*(?<currentValue>\\d+)\\s*</java\\.version>"
      ],
      "depNameTemplate": "java-jdk",
      "datasourceTemplate": "java-version",
      "versioningTemplate": "semver-partial"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^deploy\\/database-image$/"
      ],
      "matchStrings": [
        "mariadb:(?<currentValue>\\d+(?:\\.\\d+){0,2})@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "depNameTemplate": "mariadb",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "schedule": [
    "* * * * *"
  ],
  "dependencyDashboardApproval": false,
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all"
}
