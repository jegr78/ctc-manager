{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "branchConcurrentLimit": 10,
  "labels": ["dependencies", "renovate"],
  "assignees": ["jegr78"],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["/^org\\.springframework\\.boot:/"],
      "groupName": "Spring Boot"
    },
    {
      "matchPackageNames": ["/^org\\.springframework\\.security:/"],
      "groupName": "Spring Security"
    },
    {
      "matchPackageNames": [
        "/^com\\.google\\.apis:google-api-services-/",
        "/^com\\.google\\.api-client:/",
        "/^com\\.google\\.auth:/"
      ],
      "groupName": "Google API clients"
    },
    {
      "matchPackageNames": ["/^org\\.testcontainers:/"],
      "groupName": "Testcontainers"
    },
    {
      "matchPackageNames": ["/^org\\.openrewrite\\.maven:/", "/^org\\.openrewrite\\.recipe:/"],
      "groupName": "OpenRewrite"
    },
    {
      "matchPackageNames": ["/^com\\.github\\.spotbugs:/", "/^com\\.h3xstream\\.findsecbugs:/"],
      "groupName": "SpotBugs + find-sec-bugs"
    },
    {
      "description": "Keep Java major-version declarations at major precision.",
      "matchDatasources": ["java-version"],
      "matchCurrentValue": "/^\\d+$/",
      "versioning": "semver-partial"
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pom\\.xml$/"],
      "matchStrings": ["<java\\.version>\\s*(?<currentValue>\\d+)\\s*</java\\.version>"],
      "depNameTemplate": "java-jdk",
      "datasourceTemplate": "java-version",
      "versioningTemplate": "semver-partial"
    }
  ]
}
